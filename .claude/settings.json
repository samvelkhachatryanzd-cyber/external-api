{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build)",
      "Bash(npm install)",
      "Bash(npm ls:*)",
      "Bash(node --check:*)",
      "Bash(npx vite build:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d --wait)",
      "Bash(docker compose logs:*)",
      "Bash(curl http://localhost:4000/:*)",
      "Bash(curl -s http://localhost:4000/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npm run db:migrate)",
      "Bash(npm run db:seed)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.*.local)",
      "Edit(./backend/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/confirm-destructive.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-syntax.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build-frontend.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
